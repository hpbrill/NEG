function(expect_call expected)
    execute_process(COMMAND "${NEG_PROGRAM}" ${ARGN}
        INPUT_FILE "${CMAKE_CURRENT_BINARY_DIR}/neg_cli_input.txt"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT "${result}" STREQUAL "${expected}")
        message(FATAL_ERROR "Unexpected exit ${result}, expected ${expected}: ${output} ${error}")
    endif()
    if(NOT error MATCHES "Error:")
        message(FATAL_ERROR "Missing error message: ${error}")
    endif()
    if(NOT ARGN STREQUAL "1" AND NOT error MATCHES "Usage:")
        message(FATAL_ERROR "Missing usage: ${error}")
    endif()
endfunction()

file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/neg_cli_input.txt" "")
expect_call(2)
expect_call(2 0)
expect_call(2 8)
expect_call(2 abc)
expect_call(2 1x)
expect_call(2 1 2)
expect_call(2 1)
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/neg_cli_input.txt" "?\n")
expect_call(2 1)
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/neg_cli_input.txt" "???\n")
expect_call(2 1)
